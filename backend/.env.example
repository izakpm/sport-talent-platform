NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Production requires independent random secrets of at least 32 characters.
JWT_SECRET=
SESSION_SECRET=

# Copy connection details from Supabase Connect (use the pooler for Vercel).
DB_HOST=
DB_PORT=6543
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=postgres
# Optional PEM CA certificate if required by your database's certificate chain.
DB_SSL_CA=

# Google OAuth credentials and exact callback URI registered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use https://<frontend-domain>/api/auth/google/callback in production.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Private athlete resource storage (backend only; never NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
